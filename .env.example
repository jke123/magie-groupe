# ============================================
# VARIABLES D'ENVIRONNEMENT — À CONFIGURER
# Ne jamais committer le vrai fichier .env sur GitHub !
# Ces mêmes clés doivent être ajoutées dans Vercel > Settings > Environment Variables
# ============================================

# Clé secrète Flask (générer une chaîne aléatoire longue)
SECRET_KEY=une-longue-chaine-aleatoire-a-generer

# Base de données Postgres (Neon) — copier depuis neon.tech après création du projet
DATABASE_URL=postgresql://user:password@ep-xxxx.eu-central-1.aws.neon.tech/magiegroupe?sslmode=require

# Cloudinary (stockage images) — copier depuis cloudinary.com dashboard
CLOUDINARY_CLOUD_NAME=votre-cloud-name
CLOUDINARY_API_KEY=votre-api-key
CLOUDINARY_API_SECRET=votre-api-secret

# SMTP — pour l'envoi des campagnes newsletter uniquement (pas pour les messages de contact)
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=votre-email@gmail.com
SMTP_PASSWORD=votre-app-password-gmail-16-caracteres
SMTP_FROM_EMAIL=votre-email@gmail.com
